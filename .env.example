# ─── Spotify ────────────────────────────────────────────────────────────────
# Get these from https://developer.spotify.com/dashboard
# The redirect URI must be registered verbatim in the Spotify app settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Used by MoodParser for natural-language mood parsing and mid-session arc
# adjustment. Optional — the parser falls back to keyword classification when
# this is empty. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Database ────────────────────────────────────────────────────────────────
# Use host "db" when running under docker compose, "localhost" when running the
# backend directly on your machine.
POSTGRES_USER=flowstate
POSTGRES_PASSWORD=flowstate_dev
POSTGRES_DB=flowstate
DATABASE_URL=postgresql://flowstate:flowstate_dev@localhost:5432/flowstate
# Second database on the same cluster, used only by Airflow's metadata store.
# Created automatically by docker/postgres/initdb/01-create-airflow-db.sh on
# first cluster init; it must match the database name in
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN in docker-compose.yml.
AIRFLOW_POSTGRES_DB=airflow

# ─── Redis ───────────────────────────────────────────────────────────────────
# Backs the PKCE verifier store (10 minute TTL). Use "redis" as the host under
# docker compose.
REDIS_URL=redis://localhost:6379/0

# ─── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_in_production
ENVIRONMENT=development
# Where the OAuth callback redirects back into the SPA.
FRONTEND_URL=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

# ─── MLflow ──────────────────────────────────────────────────────────────────
# Only read by scripts/train_classifier.py. Defaults to http://localhost:5001,
# which is the port docker compose publishes the MLflow container on.
MLFLOW_TRACKING_URI=http://localhost:5001

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=change_this_too
